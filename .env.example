# ───────────── TravelPool configuration ─────────────
# Copy to .env and fill in. NEVER commit .env — it is gitignored.
# Every value is optional: with none set, TravelPool runs on its built-in
# review engine and a recorded ledger, and says so in the UI.

# ── AI (any OpenAI-compatible API) ──
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ── Backend ──
PORT=4000
CORS_ORIGIN=http://localhost:5173

# ── Blockchain ──
# Local Hardhat chain: npm run dev:chain
RPC_URL=http://127.0.0.1:8545
# Operator / relayer key. Leave empty on the local Hardhat node.
PRIVATE_KEY=
# Address of the deployed InsurancePool. Leave empty to read backend/data/deployment.json.
CONTRACT_ADDRESS=

# ── Sepolia deployment ──
# Only needed to deploy. PRIVATE_KEY above must hold Sepolia ETH.
# Never commit a real key.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# ── Evidence storage: "local" (default) or "ipfs" ──
STORAGE_PROVIDER=local
IPFS_API_URL=http://127.0.0.1:5001
IPFS_GATEWAY_URL=https://ipfs.io/ipfs

# ───────────── Frontend (also set these in frontend/.env) ─────────────
# Vite exposes VITE_* to the browser, so nothing secret goes here.
VITE_CHAIN_ID=11155111
VITE_CONTRACT_ADDRESS=
VITE_TOKEN_ADDRESS=
VITE_RPC_URL=
# Development fallback wallet. Set to false once real MetaMask use is verified.
VITE_ENABLE_DEMO_WALLET=true
