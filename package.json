{
  "name": "travelpool",
  "version": "1.0.0",
  "private": true,
  "description": "TravelPool — Decentralized Travel Insurance Pool with AI Claims Processing (INNOBLOCK 2.0)",
  "workspaces": [
    "frontend",
    "backend",
    "blockchain"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c cyan,magenta \"npm:backend\" \"npm:frontend\"",
    "dev:chain": "concurrently -n chain,deploy,backend,frontend -c yellow,green,cyan,magenta \"npm:blockchain\" \"npm:deploy:wait\" \"npm:backend\" \"npm:frontend\"",
    "frontend": "npm run dev --workspace frontend",
    "backend": "npm run dev --workspace backend",
    "blockchain": "npm run node --workspace blockchain",
    "deploy": "npm run deploy --workspace blockchain",
    "deploy:wait": "npm run deploy:wait --workspace blockchain",
    "compile": "npm run compile --workspace blockchain",
    "test:contracts": "npm run test --workspace blockchain",
    "build": "npm run build --workspace frontend",
    "start": "npm run build && npm run start --workspace backend",
    "reset": "npm run reset --workspace backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
